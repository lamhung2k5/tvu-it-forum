{
  "scenarios": [
    {
      "name": "Đăng ký người dùng mới",
      "endpoint": "POST /api/auth/register",
      "data": {
        "hoTen": "Trần Thị B",
        "email": "tranthib@example.com",
        "password": "Password456!"
      },
      "expectedResult": "Success - Trả về token JWT"
    },
    {
      "name": "Đăng ký với email đã tồn tại",
      "endpoint": "POST /api/auth/register",
      "data": {
        "hoTen": "Lê Văn C",
        "email": "tranthib@example.com",
        "password": "AnotherPass789#"
      },
      "expectedResult": "Error 400 - Email đã tồn tại"
    },
    {
      "name": "Đăng nhập thành công",
      "endpoint": "POST /api/auth/login",
      "data": {
        "email": "tranthib@example.com",
        "password": "Password456!"
      },
      "expectedResult": "Success - Trả về token JWT"
    },
    {
      "name": "Đăng nhập sai mật khẩu",
      "endpoint": "POST /api/auth/login",
      "data": {
        "email": "tranthib@example.com",
        "password": "SaiMatKhau123"
      },
      "expectedResult": "Error 400 - Sai mật khẩu"
    },
    {
      "name": "Đăng nhập với email không tồn tại",
      "endpoint": "POST /api/auth/login",
      "data": {
        "email": "khongtontai@example.com",
        "password": "BatKy123"
      },
      "expectedResult": "Error 400 - Email không tồn tại"
    }
  ]
}
