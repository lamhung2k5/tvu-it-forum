{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=forum.db"
  },
  "Jwt": {
    "Key": "replace-with-a-secure-secret-key-at-least-32-chars",
    "Issuer": "ForumAPI",
    "Audience": "ForumAPI",
    "ExpiresInMinutes": 60
  }
}
